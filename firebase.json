{
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node tool/install_sw_cleanup.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/@(index.html|flutter_bootstrap.js|flutter.js|flutter_service_worker.js|main.dart.js|version.json|manifest.json|resume.pdf)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
